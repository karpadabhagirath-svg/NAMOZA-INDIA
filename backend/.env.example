# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,https://namozaindia.com,https://www.namozaindia.com

# --- Database (PostgreSQL) ---
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/namoza_india?schema=public"

# --- Auth ---
# Long random string used to sign admin JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Admin seed account (used by `npm run seed`) ---
ADMIN_EMAIL="owner@namozaindia.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="Namoza India Admin"

# --- File uploads ---
UPLOAD_DIR="uploads"
MAX_UPLOAD_BYTES=10485760

# --- Email (SMTP) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey-or-username"
SMTP_PASS="smtp-password"
MAIL_FROM="Namoza India <orders@namozaindia.com>"
ADMIN_ALERT_EMAIL="owner@namozaindia.com"

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
